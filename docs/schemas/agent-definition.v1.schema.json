{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://willdeep.com/schemas/agent-definition.v1.schema.json",
  "title": "WillDeep portable agent definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "definition_id", "version", "name", "purpose", "base_role", "instructions", "input_modalities", "tools", "skills", "forked_from"],
  "properties": {
    "schema": {"const": "willdeep.agent-definition.v1"},
    "definition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,95}$", "not": {"pattern": "\\.\\."}},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc[1-9][0-9]*)?$"},
    "name": {
      "type": "object", "minProperties": 1, "maxProperties": 16,
      "propertyNames": {"pattern": "^[A-Za-z0-9-]{1,32}$"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 128},
      "anyOf": [{"required": ["en"]}, {"required": ["zh-Hans"]}]
    },
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1024},
    "base_role": {"enum": ["generalist", "implementer", "tester", "reviewer", "ops_runner"]},
    "instructions": {"type": "string", "minLength": 1, "maxLength": 16000},
    "input_modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "image"]}},
    "tools": {"type": "array", "uniqueItems": true, "items": {"enum": ["workspace.read", "workspace.edit", "process.verify", "repository.inspect"]}},
    "skills": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "content", "sha256", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,95}$", "not": {"pattern": "\\.\\."}},
          "content": {"type": "string", "maxLength": 24000},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "required": {"type": "boolean"}
        },
        "if": {"properties": {"required": {"const": true}}},
        "then": {"properties": {"content": {"minLength": 1}}}
      }
    },
    "forked_from": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
  },
  "$comment": "Runtime validation additionally rejects whitespace-only text, duplicate skill IDs, credential-shaped content, invalid UTF-8, duplicate JSON keys, oversized packages and incorrect skill hashes. Definitions do not authorize tools."
}
