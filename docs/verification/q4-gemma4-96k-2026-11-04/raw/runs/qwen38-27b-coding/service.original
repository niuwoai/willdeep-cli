[Unit]
Description=llama.cpp CUDA — Qwen3.8-27B UD-IQ3_XXS (128K, port 11435)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f qwen38-cuda
ExecStart=/usr/bin/docker run --rm --name qwen38-cuda --gpus all --network host -v /home/ml-data/src/llama.cpp-b10549/build-cuda-sm120:/llama:ro -v /home/ml-data/opt-models/unsloth-Qwen3.8-27B-GGUF:/models:ro -v /etc/qwen38:/config:ro --entrypoint /llama/bin/llama-server nvidia/cuda:12.9.1-devel-ubuntu24.04 --model /models/Qwen3.8-27B-UD-IQ3_XXS.gguf --alias qwen3.8-27b --api-key-file /config/api-key --host 0.0.0.0 --port 11435 --n-gpu-layers 99 --ctx-size 131072 --cache-type-k q4_0 --cache-type-v q4_0 --flash-attn on --parallel 2 --batch-size 512 --ubatch-size 128 --reasoning-preserve
ExecStop=/usr/bin/docker stop -t 30 qwen38-cuda
ExecStartPost=/usr/local/sbin/qwen38-warmup
TimeoutStartSec=240
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
